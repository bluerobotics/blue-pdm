{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    
    // Strict type checking
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // `scripts/**/*.ts` is checked here rather than under tsconfig.node.json because
  // scripts/repair-config-maps.ts imports src/lib/metadata/* by explicit `.ts` specifier, which
  // needs the `allowImportingTsExtensions` and `bundler` resolution this config sets. Checking it
  // against the same config as the modules it reuses is also what makes the check meaningful.
  "include": ["src", "scripts/**/*.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

