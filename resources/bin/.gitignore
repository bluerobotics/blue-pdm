# Ignore downloaded restic binaries (they're large and platform-specific)
# Run "npm run download-restic" to download them

# Windows
win32/restic.exe

# macOS
darwin/restic

# Linux
linux/restic

# SolidWorks service build output, dropped here by "npm run build-sw-service".
# The script copies every .exe/.dll/.config out of the Release folder, so match on extension
# rather than on today's six filenames. .gitkeep stays tracked.
win32/*.exe
win32/*.dll
win32/*.config

# Temporary files
*.zip
*.bz2
*.tmp

